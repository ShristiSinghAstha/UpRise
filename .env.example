# =========================================================================
# UpRise Environment Variables Configuration Template
# =========================================================================

# Node.js Server Settings
PORT=5000
NODE_ENV=production  # Set to "development" or "production"

# Database Connection (MongoDB local container or Atlas cloud instance)
# Local: mongodb://mongo:27017/UpRise (when running in docker compose)
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/UpRise
MONGO_URI=mongodb://mongo:27017/UpRise

# JWT Secret Keys (change to secure random keys in production)
JWT_SECRET=mySuperSecretKey123
ACCESS_TOKEN_SECRET=access-secret-key-change-me
REFRESH_TOKEN_SECRET=refresh-secret-key-change-me
ACCESS_TOKEN_EXPIRE=15m
REFRESH_TOKEN_EXPIRE=7d

# Frontend/Client URLs for CORS mapping
CLIENT_URL=http://localhost:80

# Mail Server Configurations (Optional)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_password
